# Copy this file to .env and fill in your own keys. Never commit .env.
# Free key from https://openchargemap.org/site/develop/api
REACT_APP_OCM_KEY=your_openchargemap_key_here
# From https://console.anthropic.com (used by server.js only, never exposed to the browser)
ANTHROPIC_API_KEY=your_anthropic_key_here
